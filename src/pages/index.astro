---
import {
  getRedis,
  parseCurrentStatus,
  parseHistoryEntry,
  type Availability,
  type HistoryEntry,
} from "../lib/redis";
import Layout from "../layouts/main.astro";
import { Image } from "astro:assets";

export const prerender = false;

let status: ReturnType<typeof parseCurrentStatus> = null;
let history: HistoryEntry[] = [];
let unavailable = false;

try {
  const redis = getRedis();
  if (redis) {
    status = parseCurrentStatus(await redis.get<unknown>("status:current"));
    const entries = await redis.zrange<unknown[]>("status:history", 0, -1, {
      rev: true,
    });
    history = entries
      .map((entry: unknown) => parseHistoryEntry(entry))
      .filter(
        (entry: HistoryEntry | null): entry is HistoryEntry => entry !== null,
      );
  } else {
    unavailable = true;
  }
} catch {
  unavailable = true;
}

const formatRelativeTime = (timestamp: number | null) => {
  if (!timestamp) return "Waiting for the first update";
  const elapsed = Math.max(0, Date.now() - timestamp);
  const minutes = Math.floor(elapsed / 60_000);
  if (minutes < 1) return "Updated just now";
  if (minutes < 60)
    return `Updated ${minutes} minute${minutes === 1 ? "" : "s"} ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `Updated ${hours} hour${hours === 1 ? "" : "s"} ago`;
  const days = Math.floor(hours / 24);
  return `Updated ${days} day${days === 1 ? "" : "s"} ago`;
};

const formatEasternTime = (timestamp: number) =>
  new Intl.DateTimeFormat("en-US", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
    timeZoneName: "short",
  }).format(new Date(timestamp));

const currentText =
  status?.availability === "asleep"
    ? "Sleeping"
    : (status?.text ?? "No status yet");
const updatedLabel = formatRelativeTime(status?.updatedAt ?? null);

const statusLabels: Record<Availability, string> = {
  free: "Available",
  away: "Away",
  busy: "Busy",
  dnd: "Do Not Disturb",
  asleep: "Asleep",
  custom: "Other",
};

const getColorForeground = (color: string) => {
  const hex = color.slice(1);
  const expanded =
    hex.length <= 4
      ? hex
          .slice(0, 3)
          .split("")
          .map((value) => value + value)
          .join("")
      : hex.slice(0, 6);
  const red = Number.parseInt(expanded.slice(0, 2), 16);
  const green = Number.parseInt(expanded.slice(2, 4), 16);
  const blue = Number.parseInt(expanded.slice(4, 6), 16);
  const brightness = (red * 299 + green * 587 + blue * 114) / 1000;
  return brightness > 155 ? "text-slate-950" : "text-white";
};

const getStatusStyle = (status: {
  availability: Availability;
  color?: string;
}) => {
  if (status.color) {
    return {
      background: "bg-transparent",
      backgroundColor: status.color,
      foreground: getColorForeground(status.color),
    };
  }

  if (status.availability === "custom") {
    return {
      background: "bg-slate-400",
      backgroundColor: status.color ?? "#94a3b8",
      foreground: "text-slate-950",
    };
  }

  const styles: Record<
    Exclude<Availability, "custom">,
    { background: string; foreground: string }
  > = {
    free: { background: "bg-emerald-400", foreground: "text-slate-950" },
    away: { background: "bg-yellow-400", foreground: "text-slate-950" },
    busy: { background: "bg-red-500", foreground: "text-white" },
    dnd: { background: "bg-purple-500", foreground: "text-white" },
    asleep: { background: "bg-blue-500", foreground: "text-white" },
  };
  return { ...styles[status.availability], backgroundColor: undefined };
};

const getStatusLabel = (availability: Availability) =>
  statusLabels[availability];
const currentStatusStyle = unavailable
  ? {
      background: "bg-destructive",
      foreground: "text-destructive-foreground",
      backgroundColor: undefined,
    }
  : status
    ? getStatusStyle(status)
    : getStatusStyle({ availability: "custom" });
const currentStatusLabel = unavailable
  ? "Unavailable"
  : getStatusLabel(status?.availability ?? "custom");
---

<Layout>
  <main
    class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center gap-8 px-6 py-12 sm:px-10"
  >
    <header
      class="flex items-center justify-center border-b border-foreground/10 pb-5"
    >
      <div>
        <Image
          src="/WhereLogo.png"
          alt="Where In The RIT Campus is Issac Liu"
          width={400}
          height={290}
          class="object-cover"
        />
      </div>
    </header>

    <section
      class={`border border-foreground/10 px-6 py-8 shadow-2xl shadow-black/5 sm:px-10 sm:py-12 ${currentStatusStyle.background} ${currentStatusStyle.foreground}`}
      style={currentStatusStyle.backgroundColor
        ? `background-color: ${currentStatusStyle.backgroundColor}`
        : undefined}
      aria-labelledby="current-status"
    >
      <div class="flex flex-wrap items-center gap-x-2 gap-y-2">
        <p id="current-status" class="text-sm text-current/70">
          Latest status:
          <span class="font-semibold">
            {" " + currentStatusLabel}
          </span>
        </p>
      </div>
      <p class="mt-4 text-5xl font-semibold tracking-tight sm:text-7xl">
        {currentText}
      </p>
      <p class="mt-5 text-sm text-current/70">
        {
          unavailable
            ? "Uh oh, Redis failed to connect! Contact Issac"
            : updatedLabel
        }
      </p>
    </section>

    <section aria-labelledby="timeline-heading">
      <div class="mb-4 flex items-end justify-between gap-4">
        <div>
          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-muted-foreground"
          >
            Last seven days
          </p>
          <h2 id="timeline-heading" class="mt-2 text-lg font-semibold">
            Status History
          </h2>
        </div>
        <p class="text-xs text-muted-foreground">
          {history.length} update{history.length === 1 ? "" : "s"}
        </p>
      </div>
      <div class="border-l border-foreground/15 pl-5">
        {
          history.length ? (
            history.map((entry) => (
              <article class="relative border-b border-foreground/10 py-4 first:pt-0 last:border-0">
                <span
                  class={`absolute -left-6.25 top-5 h-2.5 w-2.5 rounded-full ring-4 ring-background ${getStatusStyle(entry).background}`}
                  style={
                    getStatusStyle(entry).backgroundColor
                      ? `background-color: ${getStatusStyle(entry).backgroundColor}`
                      : undefined
                  }
                  aria-hidden="true"
                />
                <p class="font-medium">
                  {entry.availability === "asleep" ? "Sleeping" : entry.text}
                </p>
                <time
                  class="mt-1 block text-xs text-muted-foreground"
                  datetime={new Date(entry.timestamp).toISOString()}
                >
                  {formatEasternTime(entry.timestamp)}
                </time>
              </article>
            ))
          ) : (
            <p class="text-sm text-muted-foreground">
              No changes recorded yet.
            </p>
          )
        }
      </div>
    </section>
  </main>
</Layout>
